{
  "manifest_version": 3,
  "name": "Threadwise Companion",
  "version": "0.3.1",
  "description": "Shows the same Threadwise companion inside Gmail and Proton Mail.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://mail.proton.me/*",
    "http://127.0.0.1:8021/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://mail.proton.me/*"
      ],
      "js": [
        "provider_adapter.js",
        "analytics.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/brand/threadwise-app-icon.png"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://mail.proton.me/*"
      ]
    }
  ],
  "action": {
    "default_title": "Threadwise Companion"
  }
}
