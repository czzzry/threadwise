# Threadwise reads private local settings from .env when the companion starts.
# Copy this file to .env and fill in values on each computer. Never commit .env.

# Required only for model-assisted classification or teaching.
# Prefer the Threadwise-specific name. OPENAI_API_KEY remains a compatibility fallback.
EMAIL_AGENT_OPENAI_API_KEY=
OPENAI_API_KEY=

# Initial labeling is model-assisted only when this is explicitly set.
# Leave blank to keep the deterministic, no-model classifier.
THREADWISE_CLASSIFICATION_MODEL=

# Optional override for correction/teaching interpretation.
# Leave blank to use the product's current default teaching model.
THREADWISE_TEACHING_MODEL=

# Analytics remain off unless deliberately configured and enabled.
THREADWISE_ENVIRONMENT=development
THREADWISE_ANALYTICS_ENABLED=false
POSTHOG_PROJECT_TOKEN=
